        {
          "name": "Check job status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const job = pm.response.json();",
                  "pm.test('has a valid status', () => pm.expect(['RUNNING', 'DONE', 'FAILED']).to.include(job.status));",
                  "pm.test('progress is an array', () => pm.expect(job.progress).to.be.an('array'));",
                  "if (job.status === 'DONE') { pm.test('a finished job has a result', () => pm.expect(job.result).to.be.an('object')); }",
                  "if (job.status === 'FAILED') { pm.test('a failed job explains why', () => pm.expect(job.error).to.be.a('string').and.not.empty); }"
                ]
              }
            }
          ],
