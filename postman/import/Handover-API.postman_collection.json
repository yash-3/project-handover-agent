{
  "info": {
    "name": "Handover API",
    "description": "REST API of the project handover agent platform. Start it from the repository root with your .env loaded: `mvn -q -pl handover-api spring-boot:run`.\n\nSetup: import the Handover API - Local environment, select it, and paste your HANDOVER_API_KEY into the api_key variable. Every /api request sends it as the X-API-Key header.\n\nFolders 1 and 5 are free to run. Folders 2, 3 and 4 call Claude, GitHub and the database, or change files.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Read-only",
      "description": "Free to run. Nothing is changed and no tokens are spent.",
      "item": [
        {
          "name": "List projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('lists projects as an array', () => pm.expect(body.projects).to.be.an('array'));",
                  "pm.test('the configured project is listed', () => pm.expect(body.projects).to.include(pm.collectionVariables.get('project')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/projects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get latest draft",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with a draft, or 404 before the first draft', () => pm.expect([200, 404]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('is Markdown', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/markdown'));",
                  "  pm.test('has a status banner', () => pm.expect(pm.response.text()).to.match(/Status: (DRAFT|APPROVED)/));",
                  "} else {",
                  "  pm.test('404 body is a JSON error', () => pm.expect(pm.response.json().error).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/projects/{{project}}/draft",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "projects",
                "{{project}}",
                "draft"
              ]
            },
            "description": "Latest handover draft as Markdown. 404 until a draft has been generated."
          },
          "response": []
        },
        {
          "name": "Get trace report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is plain text', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain'));",
                  "pm.test('is a report or says no trace exists yet', () => pm.expect(pm.response.text()).to.match(/^(Trace: |No trace found)/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/projects/{{project}}/report",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "projects",
                "{{project}}",
                "report"
              ]
            },
            "description": "Plain-text summary of runs, tokens, cost and tool calls from the project's trace file."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2 Ask",
      "description": "Calls Claude (Haiku by default); a fraction of a cent per question. The project must be indexed first.",
      "item": [
        {
          "name": "Ask a question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test('has an answer', () => pm.expect(a.answer).to.be.a('string').and.not.empty);",
                  "pm.test('citations are arrays', () => { pm.expect(a.verifiedCitations).to.be.an('array'); pm.expect(a.unverifiedCitations).to.be.an('array'); });",
                  "pm.test('grounded is consistent with unverified citations', () => pm.expect(a.grounded).to.equal(a.unverifiedCitations.length === 0));",
                  "pm.test('reports tokens and cost', () => { pm.expect(a.tokens).to.be.a('number'); pm.expect(a.costUsd).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/projects/{{project}}/ask",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "projects",
                "{{project}}",
                "ask"
              ]
            },
            "description": "Answers from the indexed project sources only, with path:lines citations. Citations the agent never saw, or that point outside the real file, come back in unverifiedCitations.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How are order events published?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/projects/{{project}}/ask",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "projects",
                    "{{project}}",
                    "ask"
                  ]
                },
                "description": "Answers from the indexed project sources only, with path:lines citations. Citations the agent never saw, or that point outside the real file, come back in unverifiedCitations.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"question\": \"How are order events published?\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"answer\": \"Order events are published by OrderEventPublisher [order-service/src/main/java/com/nexus/order/event/OrderEventPublisher.java:35-45].\",\n  \"verifiedCitations\": [\n    \"order-service/src/main/java/com/nexus/order/event/OrderEventPublisher.java:35-45\"\n  ],\n  \"unverifiedCitations\": [],\n  \"grounded\": true,\n  \"tokens\": 18250,\n  \"costUsd\": \"0.0021\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "3 Background jobs",
      "description": "Slow operations run in the background: start one, then re-send Check job status until it is no longer RUNNING. Only one job per project can run at a time (409 otherwise). Draft runs call Claude and cost roughly 0.5 USD.",
      "item": [
        {
          "name": "Index project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted, or 409 if a job is already running', () => pm.expect([202, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 202) {",
                  "  const id = pm.response.json().jobId;",
                  "  pm.test('returns a job id', () => pm.expect(id).to.match(/^[0-9a-f-]{36}$/));",
                  "  pm.collectionVariables.set('job_id', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/projects/{{project}}/index",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "projects",
                "{{project}}",
                "index"
              ]
            },
            "description": "Reads the project's repos from GitHub and stores masked chunks in pgvector. No Claude cost; the first run loads the local embedding model."
          },
          "response": []
        },
        {
          "name": "Start draft",
          "event": [
